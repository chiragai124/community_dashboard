# ---------------------------------------------------------------------------
# Amber Community Dashboard — environment
#
# Copy to `.env.local` and fill in what you have. Every integration degrades
# on its own: with nothing set the dashboard runs on demo data and labels it
# as such, so you can wire the sources up one at a time.
# ---------------------------------------------------------------------------

# --- Google (Sheets + GA4) -------------------------------------------------
# One service account covers both. Create it in Google Cloud, enable the
# "Google Sheets API" and the "Google Analytics Data API", then:
#   • share the registration sheet with the service-account email (Viewer)
#   • add the same email as a Viewer on the GA4 property
#
# Either paste the whole key file as one line...
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# ...or set the two fields separately (keep the \n escapes in the key):
# GOOGLE_CLIENT_EMAIL=dashboard@my-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Registration sheet. The ID is the long string in the sheet's URL.
# GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
# Optional; defaults to the first sheet's columns A:Z.
# GOOGLE_SHEETS_RANGE=Registrations!A:Z
#
# Columns are matched by HEADER NAME, not position, so column order doesn't
# matter. Recognised headers (any one of each row works):
#   name        → Name, Full Name, Student Name
#   email       → Email, Email Address
#   country     → Country, Destination, Country of Study      (required)
#   university  → University, College, School
#   utmSource   → UTM Source, Source
#   utmMedium   → UTM Medium, Medium
#   utmCampaign → UTM Campaign, Campaign
#   timestamp   → Timestamp, Date, Submitted At               (required)

# GA4 property ID — digits only, from Admin → Property Settings.
# GA4_PROPERTY_ID=123456789

# --- Short.io --------------------------------------------------------------
# API key: Short.io dashboard → Integrations & API → API keys.
# Domain ID: numeric ID of the domain holding your tracked links.
# Tag each link with the group's tag from lib/groups.ts (e.g. community-uk).
# SHORTIO_API_KEY=sk_xxxxxxxxxxxxxxxx
# SHORTIO_DOMAIN_ID=123456

# --- Persistence for manual weekly entries ---------------------------------
# Default: a JSON file at data/weekly-entries.json. No setup needed.
# To use Supabase instead, set both of these and run supabase/schema.sql.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Tuning ----------------------------------------------------------------
# How long a pull is reused before the next page load re-pulls. Default 10 min.
# INTEGRATION_CACHE_TTL_MS=600000
